def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id:             ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content:           ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

# CI passes the release version + a monotonic build number through the
# environment; turn them into xcodebuild overrides. Empty when unset, so
# local builds fall back to the defaults in project.yml.
def version_xcargs
  args = []
  version = ENV["APP_MARKETING_VERSION"].to_s
  build   = ENV["APP_BUILD_NUMBER"].to_s
  args << "MARKETING_VERSION=#{version}" unless version.empty?
  args << "CURRENT_PROJECT_VERSION=#{build}" unless build.empty?
  args.join(" ")
end

platform :mac do
  desc "Prepare both Duo Display Mac apps locally; never publish automatically"
  lane :build_release do
    version = ENV.fetch("APP_MARKETING_VERSION")
    build = ENV.fetch("APP_BUILD_NUMBER")
    profile = ENV.fetch("DUO_NOTARY_PROFILE", "DuoDisplay")
    # Credentials and the Sparkle signing key remain in this Mac's Keychain.
    sh("python3", "../scripts/release/mac.py", "prepare",
       "--version", version, "--build", build, "--profile", profile)
  end

  desc "Receiver is prepared together with the sender"
  lane :build_receiver_release do
    UI.user_error!("Use mac build_release; it prepares both Duo Display apps together.")
  end
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if is_ci
    key = asc_api_key
    match(
      type:           "appstore",
      app_identifier: "com.peetzweg.opensidecar.ios",
      api_key:        key,
      readonly:       is_ci
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "OpenSidecar.xcodeproj",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore com.peetzweg.opensidecar.ios",
      targets:               ["OpenSidecariOS"]
    )
    build_app(
      project:          "OpenSidecar.xcodeproj",
      scheme:           "OpenSidecariOS",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/export",
      output_name:      "OpenSidecariOS",
      xcargs:           version_xcargs
    )
    # 1.30.0 shipped built with the iOS 26 SDK because the runner's default
    # Xcode was 26.6, and iPhone Duo letterboxed it (issues #446, #448).
    # Refuse to upload anything built with an older SDK than the one Duo needs.
    plist = File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE],
                      "Products/Applications/OpenSidecariOS.app/Info.plist")
    sdk = sh("/usr/libexec/PlistBuddy", "-c", "Print :DTPlatformVersion", plist).strip
    if Gem::Version.new(sdk) < Gem::Version.new("27.1")
      UI.user_error!("Built with the iOS #{sdk} SDK; iPhone Duo needs 27.1 or later")
    end
    upload_to_testflight(
      api_key:                           key,
      app_identifier:                    "com.peetzweg.opensidecar.ios",
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  # The release workflow builds the Play bundle (minSdk 24) and signs it with
  # the upload key; this lane only hands it to Google Play. Play re-signs it
  # with its own app signing key, so Play installs and the GitHub APK carry
  # different signatures (RELEASING.md).
  desc "Upload the signed Play bundle to a Google Play testing track"
  lane :play_beta do
    upload_to_play_store(
      package_name:            "com.peetzweg.opendisplay",
      json_key_data:           ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      aab:                     ENV.fetch("PLAY_AAB_PATH"),
      track:                   ENV.fetch("PLAY_TRACK", "alpha"),
      release_status:          "completed",
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true
    )
  end
end
